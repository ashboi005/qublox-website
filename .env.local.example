# ---- Sanity ---------------------------------------------------------------
# Leave these blank and the site renders from src/content/fallback.ts.
# Fill them in and every section reads from the Studio at /studio instead.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# ---- Contact form (Gmail SMTP) --------------------------------------------
# Use a Google App Password, not your account password:
# myaccount.google.com -> Security -> 2-Step Verification -> App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASSWORD=
CONTACT_TO=you@gmail.com
